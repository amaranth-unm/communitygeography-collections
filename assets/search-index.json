---
layout: null
---
[
  {% assign search_documents = site.pages | concat: site.events | concat: site.news %}
  {% assign pages_with_titles = search_documents | where_exp: "p", "p.title" %}
  {% assign separator = '' %}
  {% for page in pages_with_titles %}
    {% unless page.url contains '/assets/' or page.url contains '/search-index' or page.searchable == false %}
    {{ separator }}{
      "title": {{ page.title | jsonify }},
      "url": "{{ site.baseurl }}{{ page.url }}",
      "summary": {{ page.summary | default: "" | jsonify }},
      "content": {{ page.search_content | default: page.content | strip_html | jsonify }},
      "tags": {{ page.tags | default: "" | jsonify }},
      "date": {{ page.published_date | default: "" | jsonify }}
    }
    {% assign separator = ',' %}
    {% endunless %}
  {% endfor %}
]
